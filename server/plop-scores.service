[Unit]
Description=Plop Catcher leaderboard API
After=network.target

[Service]
ExecStart=/usr/bin/python3 /opt/plop-scores/plop_scores.py
Environment=PORT=8787
DynamicUser=yes
StateDirectory=plop-scores
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=128M
EnvironmentFile=-/etc/plop-scores.env
CPUQuota=50%
TasksMax=64
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
